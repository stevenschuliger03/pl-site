# Hugo build output and cache. Both are regenerated by every build; committing
# them causes noisy diffs and lets a stale fingerprinted stylesheet linger.
/public/
/resources/
.hugo_build.lock

# Node is only ever used via `npx wrangler`, never installed into the project.
node_modules/

# Wrangler's local state, including OAuth credentials. Must never be committed.
.wrangler/
.dev.vars
.env

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# NOTE: data/pl/*.json is deliberately NOT ignored. CI regenerates it on every
# build, but committing it keeps the repo buildable offline and makes the data
# changes reviewable in the diff -- you can see the table move gameweek to
# gameweek in the history.

# Python bytecode from running the tools locally.
__pycache__/
*.py[cod]

# Local Claude Code dev-server config. Contains absolute paths specific to one
# machine (C:/Users/steve/bin/hugo.exe), so it is useless to anyone else.
.claude/
